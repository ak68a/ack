# Run `TENDERLY_ACCESS_KEY=xxx pnpm setup` to generate these automatically.

# Tenderly Virtual TestNet RPC URLs (generated by setup script)
TENDERLY_RPC_URL=https://virtual.sepolia.rpc.tenderly.co/xxxxxxxx
TENDERLY_ADMIN_RPC_URL=https://virtual.sepolia.rpc.tenderly.co/xxxxxxxx

# Owner private key (the principal who delegates authority)
OWNER_PRIVATE_KEY=0x...

# Agent private key (the agent receiving delegated authority)
AGENT_PRIVATE_KEY=0x...

# Tenderly access key (only needed for setup, not for running the demo)
# Get from https://dashboard.tenderly.co → Settings → Authorization
TENDERLY_ACCESS_KEY=
